# =======================================================================
# SecureChain: Backend Environment Configuration (.env.example)
# =======================================================================

# Django Secret Key (Generate a secure unique key in production)
DJANGO_SECRET_KEY=replace-with-a-random-secret-key-in-production

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,.vercel.app

# Cross-Origin Resource Sharing (CORS) allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-app.vercel.app
