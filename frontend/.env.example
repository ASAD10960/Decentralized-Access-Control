# =======================================================================
# SecureChain: Frontend Environment Configuration (.env.example)
# =======================================================================

# Public URL of the Django REST Framework API
# Defaults to http://127.0.0.1:8000 in local development
NEXT_PUBLIC_API_URL=https://your-backend-api.onrender.com

# Ethereum RPC Node URL (Localhost Hardhat or Sepolia / Polygon testnet)
NEXT_PUBLIC_BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org
